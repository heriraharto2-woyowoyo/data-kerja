<?php
// ============================================================
//  DOWNLOAD & EKSTRAK ojs-3.3.0-21 (PharData untuk tar.gz)
//  Tanpa exec / shell / system
// ============================================================
set_time_limit(0);
ini_set('memory_limit', '512M');

$message = '';
$targetDir = __DIR__; // langsung di direktori script ini

if (isset($_POST['download'])) {
    // URL TAR.GZ ojs-3.3.0-21
    $url = 'http://pkp.sfu.ca/ojs/download/ojs-3.3.0-21.tar.gz';
    $archiveName = 'ojs-3.3.0-21.tar.gz';
    $archivePath = $targetDir . '/' . $archiveName;

    // --- 1. Download file dengan CURL ---
    $ch = curl_init($url);
    $fp = fopen($archivePath, 'w+');
    curl_setopt($ch, CURLOPT_FILE, $fp);
    curl_setopt($ch, CURLOPT_TIMEOUT, 300);
    curl_setopt($ch, CURLOPT_FOLLOWLOCATION, true);
    curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, false);
    curl_exec($ch);
    $httpCode = curl_getinfo($ch, CURLINFO_HTTP_CODE);
    curl_close($ch);
    fclose($fp);    

    if ($httpCode !== 200 || !file_exists($archivePath) || filesize($archivePath) < 1000) {
        $message = "❌ Gagal download (HTTP $httpCode). Coba manual.";
        @unlink($archivePath);
    } else {
        $message = "✅ Download berhasil: " . number_format(filesize($archivePath)) . " bytes<br>";

        // --- 2. Ekstrak dengan PharData (karena format tar.gz) ---
        $extractTo = $targetDir . '/ojs-3.3.0-21'; // folder tujuan
        if (!is_dir($extractTo)) mkdir($extractTo, 0777, true);

        if (class_exists('PharData')) {
            try {
                $phar = new PharData($archivePath);
                // Ekstrak semua isi arsip
                $res = $phar->extractTo($extractTo);

                // Hitung jumlah file yang berhasil diekstrak
                $count = 0;
                foreach (new RecursiveIteratorIterator(new RecursiveDirectoryIterator($extractTo, FilesystemIterator::SKIP_DOTS)) as $f) {
                    if ($f->isFile()) $count++;
                }
                $message .= "✅ Berhasil ekstrak ke folder 'ojs-3.3.0-21' ($count file).";
                
                // Hapus arsip jika dicentang
                if (isset($_POST['delete_zip']) && unlink($archivePath)) {
                    $message .= " 🗑️ File arsip dihapus.";
                }
            } catch (Exception $e) {
                $message .= "❌ Ekstrak gagal: " . $e->getMessage();
            }
        } else {
            $message .= "❌ Kelas PharData tidak tersedia di server. Pastikan ekstensi phar diaktifkan.";
        }
    }
}
?>
<!DOCTYPE html>
<html>
<head><meta charset="UTF-8"><title>Install ojs-3.3.0-21</title></head>
<body style="font-family:Arial;padding:20px;">
<h2>📥 Download & Install ojs-3.3.0-21 (tar.gz)</h2>
<?php if ($message) echo '<div style="background:#dff0d8;padding:15px;border-radius:5px;margin-bottom:20px;">'.$message.'</div>'; ?>
<form method="post">
    <p>Klik tombol di bawah untuk mendownload <strong>ojs-3.3.0-21.tar.gz</strong> dan mengekstrak ke folder <strong>ojs-3.3.0-21</strong> di direktori saat ini.</p>
    <input type="checkbox" name="delete_zip" id="del" checked> <label for="del">Hapus file arsip setelah ekstrak</label><br><br>
    <input type="submit" name="download" value="Download & Ekstrak" style="background:#27ae60;color:#fff;padding:12px 30px;border:none;border-radius:5px;font-size:16px;cursor:pointer;">
</form>
<hr>
<p><strong>Catatan:</strong> Proses ini murni menggunakan PHP (CURL + PharData), tanpa perlu akses terminal. Pastikan ekstensi <code>phar</code> diaktifkan di server.</p>
</body>
</html>
