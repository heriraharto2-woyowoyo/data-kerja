    }

    *{box-sizing:border-box;margin:0;padding:0}

    html{background:#020202}

    body{
      min-height:100vh;
      padding:18px 12px 28px;
      color:var(--white);
      font-family:'Inter',Arial,sans-serif;
      background:
        radial-gradient(circle at 50% -10%,rgba(255,199,0,.18),transparent 30%),
        radial-gradient(circle at 10% 20%,rgba(255,217,0,.08),transparent 18%),
        radial-gradient(circle at 90% 70%,rgba(255,174,0,.07),transparent 22%),
        #020202;
      overflow-x:hidden;
    }

    .page-shell{
      width:100%;
      max-width:470px;
      margin:0 auto;
      position:relative;
      z-index:2;
    }

    .ambient{
      position:fixed;
      inset:0;
      pointer-events:none;
      z-index:0;
      overflow:hidden;
    }

    .ambient:before,
    .ambient:after{
      content:"";
      position:absolute;
      inset:-80px;
      background-image:
        radial-gradient(circle,rgba(255,226,95,.95) 0 1px,transparent 1.8px),
        radial-gradient(circle,rgba(255,168,0,.9) 0 1.2px,transparent 2px),
        radial-gradient(circle,rgba(255,242,178,.6) 0 .8px,transparent 1.6px);
      background-size:73px 73px,119px 119px,157px 157px;
      background-position:0 0,20px 45px,60px 10px;
      animation:drift 22s linear infinite;
      opacity:.62;
    }

    .ambient:after{
      transform:scale(1.12);
      animation-duration:32s;
      animation-direction:reverse;
      opacity:.28;
      filter:blur(.2px);
    }

    @keyframes drift{
      from{transform:translate3d(0,0,0)}
      to{transform:translate3d(50px,80px,0)}
    }

    .machine{
      position:relative;
      padding:12px;
      border:1px solid rgba(255,239,166,.7);
      border-radius:26px;
      background:
        linear-gradient(145deg,rgba(255,255,255,.32),transparent 18%),
        linear-gradient(110deg,#8a5900 0%,#d2a72c 12%,#fff0a1 39%,#c59620 63%,#704400 100%);
      box-shadow:
        0 24px 80px rgba(0,0,0,.85),
        0 0 45px rgba(255,191,0,.18),
        inset 0 1px 0 rgba(255,255,255,.7),
        inset 0 -8px 18px rgba(92,51,0,.35);
      overflow:hidden;
    }

    .machine:before{
      content:"";
      position:absolute;
      inset:6px;
      border-radius:20px;
      border:1px solid rgba(79,45,0,.58);
      box-shadow:inset 0 0 0 1px rgba(255,250,210,.2);
      pointer-events:none;
    }

    .machine:after{
      content:"";
      position:absolute;
      width:60%;
      height:140%;
      left:-45%;
      top:-20%;
      transform:rotate(18deg);
      background:linear-gradient(90deg,transparent,rgba(255,255,255,.22),transparent);
      animation:metalShine 7s ease-in-out infinite;
      pointer-events:none;
    }

    @keyframes metalShine{
      0%,52%{left:-70%;opacity:0}
      62%{opacity:.55}
      82%,100%{left:120%;opacity:0}
    }

    .bolt{
      position:absolute;
      z-index:5;
      width:14px;
      height:14px;
      border-radius:50%;
      background:radial-gradient(circle at 35% 30%,#666 0,#1b1b1b 38%,#050505 72%);
      border:1px solid #2a1900;
      box-shadow:0 1px 3px rgba(0,0,0,.9),inset 0 1px 1px rgba(255,255,255,.25);
    }

    .bolt:after{
      content:"";
      position:absolute;
      width:8px;
      height:2px;
      top:5px;
      left:2px;
      border-radius:4px;
      background:#090909;
      transform:rotate(45deg);
    }

    .bolt.tl{top:10px;left:10px}
    .bolt.tr{top:10px;right:10px}
    .bolt.bl{bottom:10px;left:10px}
    .bolt.br{bottom:10px;right:10px}

    .topbar{
      position:relative;
      z-index:3;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      padding:14px 15px 11px;
    }

    .logo-wrap{
      min-width:0;
      display:flex;
      align-items:center;
      gap:10px;
    }

    .logo-box{
      width:152px;
      max-width:54vw;
      filter:drop-shadow(0 0 10px rgba(255,217,0,.28));
    }

    .status{
      display:flex;
      align-items:center;
      gap:7px;
      font-size:9px;
      font-weight:800;
      letter-spacing:1.4px;
      text-transform:uppercase;
      color:#211500;
      white-space:nowrap;
    }

    .status-dot{
      width:8px;
      height:8px;
      border-radius:50%;
      background:#1bff74;
      box-shadow:0 0 9px rgba(27,255,116,.85);
      animation:pulse 1.6s ease-in-out infinite;
    }

    @keyframes pulse{
      0%,100%{transform:scale(.85);opacity:.65}
      50%{transform:scale(1.2);opacity:1}
    }

    .screen{
      position:relative;
      z-index:3;
      overflow:hidden;
      border-radius:18px;
      padding:5px;
      background:linear-gradient(135deg,#0b0800,#a69012,#7d4b00,#9b8314);
