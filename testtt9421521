      --gold:#ffd900;
      --gold-2:#ffb800;
      --gold-soft:#fff0a7;
      --bronze:#8f5d00;
      --ink:#050505;
      --panel:#0c0a04;
      --panel-2:#151004;
      --line:rgba(255,217,0,.22);
