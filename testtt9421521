      border-radius:999px;
      color:#d9c780;
      font-size:8px;
      font-weight:800;
      letter-spacing:.7px;
      text-transform:uppercase;
    }

    .info-list{
      list-style:none;
      padding:3px 0;
    }

    .info-list li{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      min-height:38px;
      padding:8px 13px;
