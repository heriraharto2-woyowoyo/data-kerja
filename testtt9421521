    .info-head{
      display:flex;
      align-items:center;
      justify-content:space-between;
      padding:12px 13px;
      border-bottom:1px solid var(--line);
    }

    .info-title{
      font-family:'Orbitron',sans-serif;
      font-size:10px;
      font-weight:800;
      letter-spacing:2px;
      color:var(--gold);
      text-transform:uppercase;
