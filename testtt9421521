      color:#342100;
      font-size:10px;
      font-weight:800;
      letter-spacing:.6px;
      text-align:center;
    }

    .quick-note:before{
      content:"◆";
      color:#8b5a00;
      font-size:9px;
    }

    .actions{
      position:relative;
      z-index:3;
      display:grid;
      gap:9px;
    }

    .action{
      position:relative;
      display:flex;
      align-items:center;
      justify-content:center;
      min-height:52px;
      padding:12px 54px 12px 18px;
      overflow:hidden;
      border:1px solid rgba(255,220,70,.32);
      border-radius:15px;
      text-decoration:none;
      color:#a58c0e;
      background:
        linear-gradient(180deg,rgba(255,255,255,.035),transparent 45%),
        linear-gradient(90deg,#060606,#131005 52%,#060606);
      box-shadow:
        0 6px 16px rgba(75,39,0,.3),
        inset 0 0 0 1px rgba(0,0,0,.8);
      font-family:'Orbitron',sans-serif;
      font-size:13px;
      font-weight:800;
      letter-spacing:2px;
      text-transform:uppercase;
      transition:transform .2s ease,box-shadow .2s ease;
    }

    .action:before{
      content:"";
      position:absolute;
      inset:0;
      background:linear-gradient(110deg,transparent 15%,rgba(255,229,102,.2) 48%,transparent 75%);
      transform:translateX(-120%);
      animation:buttonSweep 3.8s ease-in-out infinite;
    }

    .action:nth-child(2):before{animation-delay:.55s}
    .action:nth-child(3):before{animation-delay:1.1s}

    @keyframes buttonSweep{
      0%,58%{transform:translateX(-120%)}
      80%,100%{transform:translateX(120%)}
    }

    .action:after{
      content:"›";
      position:absolute;
      right:8px;
      top:50%;
      transform:translateY(-50%);
      display:grid;
      place-items:center;
      width:36px;
      height:36px;
      border-radius:11px;
      color:#111;
      background:linear-gradient(135deg,#8d7605,#ffc400 70%,#b66a00);
