    @media (max-width:390px){
      body{padding:9px 7px 18px}
      .machine{padding:9px;border-radius:22px}
      .machine:before{inset:5px;border-radius:17px}
      .topbar{padding:13px 12px 9px}
      .logo-box{width:136px}
      .status{font-size:8px;letter-spacing:1px}
      .screen{border-radius:15px;padding:4px}
      .screen-inner{border-radius:11px}
      .action{min-height:49px;font-size:12px;letter-spacing:1.6px}
      .feature-grid{gap:6px}
      .feature{padding:9px 4px}
      .info-list li{padding:8px 10px}
    }

    @media (max-width:330px){
      .status span:last-child{display:none}
      .action{font-size:11px}
      .feature strong{font-size:10px}
      .feature span{font-size:7px}
    }

    @media (prefers-reduced-motion:reduce){
      .ambient:before,.ambient:after,.machine:after,.status-dot,.action:before{
        animation:none;
      }
    }
  </style>
</head>

