      font-size:9px;
      font-weight:800;
      letter-spacing:1.5px;
      text-transform:uppercase;
    }

    .footer-line{
      width:84px;
      height:4px;
      margin:0 auto 11px;
      border-radius:999px;
      background:linear-gradient(90deg,transparent,#1f1400,transparent);
      opacity:.75;
