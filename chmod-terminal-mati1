<?php
// ============================================================
//  chmod-htaccess.php
//  Ubah permission semua .htaccess dari 0644 -> 0444
//  Pure PHP - aman untuk web (tanpa exec/shell)
// ============================================================
set_time_limit(0);
ignore_user_abort(true);
ini_set('memory_limit', '256M');

// ---------- CONFIG ----------
$TARGET_ROOT   = '/www/wwwroot/jurnal.kolaborasi.unpand.ac.id/plugins/';
$LOG_FILE      = __DIR__ . '/chmod-htaccess.log';
$STATE_FILE    = __DIR__ . '/chmod-htaccess.state';
$TARGET_MODE   = 0444;                       // read-only semua
$SKIP_REGEX    = '#/(\.git|node_modules|vendor|cache|tmp|logs)$#';
// ----------------------------

$message = '';
$fatal   = '';
$stats   = ['total' => 0, 'changed' => 0, 'already' => 0, 'failed' => 0];

function log_line($file, $msg) {
    @file_put_contents($file, '[' . date('Y-m-d H:i:s') . "] $msg\n", FILE_APPEND);
}

// ---------- Validasi ----------
if (!is_dir($TARGET_ROOT)) {
    $fatal = "❌ Target root tidak ada: " . htmlspecialchars($TARGET_ROOT);
}

// ---------- Aksi ----------
if ($_SERVER['REQUEST_METHOD'] === 'POST' && !$fatal) {
    $dryRun     = isset($_POST['dryrun']);
    $resetState = isset($_POST['reset_state']);

    if ($resetState) {
        @unlink($STATE_FILE);
        log_line($LOG_FILE, "STATE RESET");
    }

    // Load state
    $done = [];
    if (is_file($STATE_FILE)) {
        $done = array_flip(array_filter(array_map('trim', file($STATE_FILE))));
    }

    log_line($LOG_FILE, "=== START chmod targetMode=" . decoct($TARGET_MODE) . " dry=$dryRun ===");

    // Kumpulkan semua .htaccess
    $files = [];
    $it = new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator($TARGET_ROOT, RecursiveDirectoryIterator::SKIP_DOTS),
        RecursiveIteratorIterator::SELF_FIRST
    );
    foreach ($it as $item) {
        if (!$item->isFile()) continue;
        $path = $item->getPathname();
        if (basename($path) !== '.htaccess') continue;
        if (preg_match($SKIP_REGEX, $path)) continue;
        $files[] = $path;
    }

    $stats['total'] = count($files);

    foreach ($files as $file) {
        if (isset($done[$file])) continue;

        // Clear stat cache biar permission yang dibaca fresh
        clearstatcache(true, $file);

        $current = fileperms($file) & 0777;
        $want    = $TARGET_MODE & 0777;

        if ($current === $want) {
            $stats['already']++;
            file_put_contents($STATE_FILE, $file . "\n", FILE_APPEND);
            continue;
        }

        if ($dryRun) {
            log_line($LOG_FILE, sprintf("[DRY] %s  0%o -> 0%o", $file, $current, $want));
            $stats['changed']++;
            file_put_contents($STATE_FILE, $file . "\n", FILE_APPEND);
            continue;
        }

        if (@chmod($file, $want)) {
            clearstatcache(true, $file);
            $now = fileperms($file) & 0777;
            if ($now === $want) {
                $stats['changed']++;
                log_line($LOG_FILE, sprintf("OK  %s  0%o -> 0%o", $file, $current, $now));
            } else {
                $stats['failed']++;
                log_line($LOG_FILE, sprintf("VERIFY-FAIL %s  want=0%o got=0%o", $file, $want, $now));
            }
            file_put_contents($STATE_FILE, $file . "\n", FILE_APPEND);
        } else {
            $stats['failed']++;
            log_line($LOG_FILE, sprintf("FAIL %s  current=0%o", $file, $current));
        }
    }

    log_line($LOG_FILE, "=== DONE total={$stats['total']} changed={$stats['changed']} already={$stats['already']} failed={$stats['failed']} ===");
    $message = "✅ Selesai. Total: <b>{$stats['total']}</b> | "
             . "Changed: <b>{$stats['changed']}</b> | "
             . "Already 0444: <b>{$stats['already']}</b> | "
             . "Failed: <b>{$stats['failed']}</b>"
             . ($dryRun ? "<br><i>Mode DRY-RUN — tidak ada file yang diubah.</i>" : "");
}

$processed = is_file($STATE_FILE) ? count(file($STATE_FILE)) : 0;
?>
