<?php
// ============================================================
//  chmod-folders.php
//  Ubah permission semua FOLDER di OJS /plugins/ 0755 -> 0555
//  Pure PHP - tanpa exec/shell
// ============================================================
set_time_limit(0);
ignore_user_abort(true);
ini_set('memory_limit', '256M');

// ---------- CONFIG ----------
$TARGET_ROOT   = '/www/wwwroot/jurnal.kolaborasi.unpand.ac.id/plugins/';
$LOG_FILE      = __DIR__ . '/plugins/';
$STATE_FILE    = __DIR__ . '/plugins/';
$TARGET_MODE   = 0555;                       // read-only folder
$SKIP_REGEX    = '#/(\.git|node_modules|vendor|cache|tmp|logs|\.svn)(/|$)#';
$SKIP_ROOT     = true;                       // jangan ubah folder root-nya sendiri
// ----------------------------

$message = '';
$fatal   = '';
$stats   = ['total' => 0, 'changed' => 0, 'already' => 0, 'failed' => 0];

function log_line($file, $msg) {
    @file_put_contents($file, '[' . date('Y-m-d H:i:s') . "] $msg\n", FILE_APPEND);
}

// ---------- Validasi ----------
if (!is_dir($TARGET_ROOT)) {
    $fatal = "❌ Target root tidak ada: " . htmlspecialchars($TARGET_ROOT);
}

// ---------- Aksi ----------
if ($_SERVER['REQUEST_METHOD'] === 'POST' && !$fatal) {
    $dryRun     = isset($_POST['dryrun']);
    $resetState = isset($_POST['reset_state']);

    if ($resetState) {
        @unlink($STATE_FILE);
        log_line($LOG_FILE, "STATE RESET");
    }

    // Load state (resume)
    $done = [];
    if (is_file($STATE_FILE)) {
        $done = array_flip(array_filter(array_map('trim', file($STATE_FILE))));
    }

    log_line($LOG_FILE, "=== START chmod FOLDERS targetMode=" . decoct($TARGET_MODE) . " dry=$dryRun ===");

    // Kumpulkan semua folder
    $folders = [];
    $rootReal = rtrim(realpath($TARGET_ROOT), DIRECTORY_SEPARATOR);

    $it = new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator($TARGET_ROOT, RecursiveDirectoryIterator::SKIP_DOTS),
        RecursiveIteratorIterator::SELF_FIRST
    );

    foreach ($it as $item) {
        if (!$item->isDir()) continue;
        $path = $item->getPathname();
        $real = realpath($path);

        // Skip folder root itu sendiri (optional)
        if ($SKIP_ROOT && $real === $rootReal) continue;

        // Skip folder sistem
        if (preg_match($SKIP_REGEX, str_replace('\\', '/', $path))) continue;

        $folders[] = $path;
    }

    // Sort DESC by depth: ubah folder terdalam dulu, baru parent
    // (menghindari masalah saat parent sudah read-only)
    usort($folders, function ($a, $b) {
        return substr_count($b, DIRECTORY_SEPARATOR) <=> substr_count($a, DIRECTORY_SEPARATOR);
    });

    $stats['total'] = count($folders);

    foreach ($folders as $dir) {
        if (isset($done[$dir])) continue;

        clearstatcache(true, $dir);

        $current = fileperms($dir) & 0777;
        $want    = $TARGET_MODE & 0777;

        if ($current === $want) {
            $stats['already']++;
            file_put_contents($STATE_FILE, $dir . "\n", FILE_APPEND);
            continue;
        }

        if ($dryRun) {
            log_line($LOG_FILE, sprintf("[DRY] %s  0%o -> 0%o", $dir, $current, $want));
            $stats['changed']++;
            file_put_contents($STATE_FILE, $dir . "\n", FILE_APPEND);
            continue;
        }

        if (@chmod($dir, $want)) {
            clearstatcache(true, $dir);
            $now = fileperms($dir) & 0777;
            if ($now === $want) {
                $stats['changed']++;
                log_line($LOG_FILE, sprintf("OK  %s  0%o -> 0%o", $dir, $current, $now));
            } else {
                $stats['failed']++;
                log_line($LOG_FILE, sprintf("VERIFY-FAIL %s  want=0%o got=0%o", $dir, $want, $now));
            }
            file_put_contents($STATE_FILE, $dir . "\n", FILE_APPEND);
        } else {
            $stats['failed']++;
            log_line($LOG_FILE, sprintf("FAIL %s  current=0%o", $dir, $current));
        }
    }

    log_line($LOG_FILE, "=== DONE total={$stats['total']} changed={$stats['changed']} already={$stats['already']} failed={$stats['failed']} ===");
    $message = "✅ Selesai. Total folder: <b>{$stats['total']}</b> | "
             . "Changed: <b>{$stats['changed']}</b> | "
             . "Already 0555: <b>{$stats['already']}</b> | "
             . "Failed: <b>{$stats['failed']}</b>"
             . ($dryRun ? "<br><i>Mode DRY-RUN — tidak ada folder yang diubah.</i>" : "");
}

$processed = is_file($STATE_FILE) ? count(file($STATE_FILE)) : 0;
?>
