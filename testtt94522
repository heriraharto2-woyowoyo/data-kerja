<?php
// ============================================================
//  CHMOD RECURSIVE - FOLDER & FILE
//  Target: /home/aisthesi/ojs.institutemandalika.com/plugins/
//  From 0555 -> 0755 (folder)
// ============================================================
set_time_limit(0);
error_reporting(0);
ini_set('display_errors', 0);

$defaultPath = '/home/aisthesi/ojs.institutemandalika.com/plugins/';
$scanPath = isset($_POST['target_path']) && !empty($_POST['target_path'])
            ? $_POST['target_path']
            : $defaultPath;

$folderMode = isset($_POST['folder_mode']) ? octdec($_POST['folder_mode']) : 0755;
$fileMode   = isset($_POST['file_mode'])   ? octdec($_POST['file_mode'])   : 0644;

$message = '';
$folderCount = 0;
$fileCount = 0;
$errors = [];

if (isset($_POST['chmod'])) {
    if (!is_dir($scanPath)) {
        $message = "❌ Path tidak ditemukan: " . htmlspecialchars($scanPath);
    } else {
        // --- Chmod folder utama dulu ---
        if (@chmod($scanPath, $folderMode)) {
            $folderCount++;
        } else {
            $errors[] = "Gagal chmod root: " . htmlspecialchars($scanPath);
        }

        // --- Iterasi folder & file rekursif ---
        try {
            $iterator = new RecursiveIteratorIterator(
                new RecursiveDirectoryIterator($scanPath, RecursiveDirectoryIterator::SKIP_DOTS),
                RecursiveIteratorIterator::SELF_FIRST
            );

            foreach ($iterator as $item) {
                $path = $item->getPathname();
                $currentPerm = substr(sprintf('%o', fileperms($path)), -4);

                if ($item->isDir()) {
                    // Skip kalau udah 0755
                    if ($currentPerm === '0755') continue;
                    if (@chmod($path, $folderMode)) {
                        $folderCount++;
                    } else {
                        $errors[] = "Gagal chmod folder: " . str_replace($scanPath, '', $path);
                    }
                } elseif ($item->isFile()) {
                    // Skip kalau udah 0644
                    if ($currentPerm === '0644') continue;
                    if (@chmod($path, $fileMode)) {
                        $fileCount++;
                    } else {
                        $errors[] = "Gagal chmod file: " . str_replace($scanPath, '', $path);
                    }
                }
            }
        } catch (Exception $e) {
            $errors[] = "Exception: " . $e->getMessage();
        }

        $message  = "✅ Selesai!<br>";
        $message .= "📁 Folder di-chmod: <strong>$folderCount</strong> (mode <code>" . sprintf('%04o', $folderMode) . "</code>)<br>";
        $message .= "📄 File di-chmod: <strong>$fileCount</strong> (mode <code>" . sprintf('%04o', $fileMode) . "</code>)";

        if (!empty($errors)) {
            $message .= "<br><br>⚠️ Errors (" . count($errors) . "):<br>" . implode('<br>', array_slice($errors, 0, 20));
            if (count($errors) > 20) {
                $message .= "<br>... dan " . (count($errors) - 20) . " error lainnya";
            }
        }
    }
}

// --- Scan preview (mode saat ini) ---
$preview = [];
if (isset($_POST['scan']) || isset($_POST['chmod'])) {
    if (is_dir($scanPath)) {
        try {
            $it = new RecursiveIteratorIterator(
                new RecursiveDirectoryIterator($scanPath, RecursiveDirectoryIterator::SKIP_DOTS),
                RecursiveIteratorIterator::SELF_FIRST
            );
            foreach ($it as $item) {
                $perm = substr(sprintf('%o', fileperms($item->getPathname())), -4);
                $preview[] = [
                    'type' => $item->isDir() ? 'DIR ' : 'FILE',
                    'perm' => $perm,
                    'path' => str_replace($scanPath, '', $item->getPathname())
                ];
                if (count($preview) >= 100) break; // limit preview
            }
        } catch (Exception $e) {}
    }
}
