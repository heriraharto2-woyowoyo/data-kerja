        <div class="row">
            <div>
                <label>Folder Mode (octal):</label>
                <input type="text" name="folder_mode" value="0555" placeholder="0555">
            </div>
            <div>
                <label>File Mode (octal):</label>
                <input type="text" name="file_mode" value="0444" placeholder="0444">
            </div>
        </div>

        <button type="submit" name="scan" value="1" class="secondary">🔍 Scan Preview</button>
        <button type="submit" name="chmod" value="1" class="danger" onclick="return confirm('Yakin LOCKDOWN? Folder jadi 0555, file jadi 0444 (read-only).')">🔒 Lockdown (Read-Only)</button>
    </form>

    <?php if (!empty($preview)): ?>
        <h3 style="margin-top:25px;">📋 Preview (max 100 item)</h3>
        <table>
            <tr><th>Type</th><th>Perm</th><th>Path</th></tr>
            <?php foreach ($preview as $p): ?>
                <tr>
                    <td><?= $p['type'] ?></td>
                    <td class="<?= in_array($p['perm'], ['0755','0644','0777']) ? 'perm-bad' : 'perm-good' ?>">
                        <?= $p['perm'] ?>
                    </td>
                    <td><?= htmlspecialchars($p['path']) ?></td>
                </tr>
            <?php endforeach; ?>
        </table>
        <p class="legend">* <span class="perm-bad">Merah</span> = masih writable (0755/0644/0777), <span class="perm-good">Hijau</span> = udah read-only</p>
    <?php endif; ?>

    <p style="font-size: 13px; color: #888; margin-top: 20px;">
        *Skrip ini murni PHP (tidak menggunakan shell_exec/system).<br>
        *Buat unlock lagi, pakai versi <code>0755</code>.
    </p>
