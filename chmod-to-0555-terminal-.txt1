        <div class="msg <?= strpos($message, '❌') !== false ? 'error' : '' ?>">
            <?= $message ?>
        </div>
    <?php endif; ?>

    <div class="warning-box">
        <strong>🔒 MODE LOCKDOWN (READ-ONLY):</strong><br>
        • Folder: <code>0755 → 0555</code> (r-xr-xr-x)<br>
