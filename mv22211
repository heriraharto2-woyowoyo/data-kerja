<?php
// ============================================================
//  PINDAHKAN SEMUA FILE DARI BACKUP OJS KE ROOT
//  Tanpa exec, murni PHP
// ============================================================
set_time_limit(0);

// === PATH SESUAI REQUEST LU ===
$src  = '/home/u336528771/domains/thefikr.org/public_html/ojs-3.1.2-1/ojs-3.1.2-1';
$dest = '/home/u336528771/domains/thefikr.org/public_html/';
// ==============================

$message = '';

if (isset($_POST['move'])) {
    if (!is_dir($src)) {
        $message = "❌ Sumber folder tidak ditemukan: " . htmlspecialchars($src);
    } else {
        $overwrite = isset($_POST['overwrite']);
        $count = 0;
        $errors = [];

        // --- Pindahkan semua file & folder (pakai RecursiveIterator) ---
        $iterator = new RecursiveIteratorIterator(
            new RecursiveDirectoryIterator($src, RecursiveDirectoryIterator::SKIP_DOTS),
            RecursiveIteratorIterator::SELF_FIRST
        );

        foreach ($iterator as $item) {
            $relPath = substr($item->getPathname(), strlen($src) + 1);
            $target = $dest . '/' . $relPath;

            if ($item->isDir()) {
                if (!is_dir($target)) {
                    mkdir($target, 0777, true);
                }
            } else {
                // File
                if (file_exists($target) && !$overwrite) {
                    $errors[] = "Lewati: $relPath (tujuan sudah ada)";
                    continue;
                }
                if (rename($item->getPathname(), $target)) {
                    $count++;
                } else {
                    $errors[] = "Gagal memindahkan: $relPath";
                }
            }
        }

        // --- Bersihkan folder sumber (hapus semua file & subfolder yang tersisa) ---
        $iterator2 = new RecursiveIteratorIterator(
            new RecursiveDirectoryIterator($src, RecursiveDirectoryIterator::SKIP_DOTS),
            RecursiveIteratorIterator::CHILD_FIRST
        );
        foreach ($iterator2 as $item) {
            if ($item->isDir()) {
                @rmdir($item->getPathname());
            } else {
                @unlink($item->getPathname());
            }
        }
        @rmdir($src); // hapus folder ojs-3.3.0-21 (yang dalam)
        @rmdir(dirname($src)); // hapus folder ojs-3.3.0-21 (yang luar) jika sudah kosong

        $message = "✅ Berhasil memindahkan $count file ke document root.";
        if (!empty($errors)) {
            $message .= "<br>⚠️ " . implode('<br>', $errors);
        }
    }
}
