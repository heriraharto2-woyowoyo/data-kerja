#!/usr/bin/env php
<?php
/**
 * Cloaking Detector – Compare normal vs Googlebot responses
 * Usage: php cloak_detect.php <url> [--follow]
 * Example: php cloak_detect.php https://example.com --follow
 */

// ================== CONFIG ==================
$timeout = 10;
$maxRedirects = 5;
// ============================================

if (php_sapi_name() !== 'cli') {
    die("This script is CLI only.\n");
}

// Parse arguments
$options = getopt('', ['follow']);
$follow = isset($options['follow']);
$url = $argv[1] ?? null;

if (!$url) {
    echo "Usage: php cloak_detect.php <url> [--follow]\n";
    exit(1);
}

// Normalize URL
if (!filter_var($url, FILTER_VALIDATE_URL)) {
    $url = 'http://' . $url;
}

// User agents
$agents = [
    'normal' => 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36',
    'googlebot' => 'Mozilla/5.0 (compatible; Googlebot/2.1; +http://www.google.com/bot.html)'
];

echo "\n🔍 Scanning: $url\n";
echo str_repeat('-', 60) . "\n";

$results = [];
foreach ($agents as $name => $ua) {
    $results[$name] = fetch($url, $ua, $follow, $timeout, $maxRedirects);
    echo "✅ $name: HTTP {$results[$name]['code']} | Size: " . number_format($results[$name]['size']) . " bytes\n";
}

// Compare
echo "\n" . str_repeat('-', 60) . "\n";
$diff = compare($results['normal'], $results['googlebot']);

if (empty($diff)) {
    echo "✅ No cloaking detected – responses are identical.\n";
} else {
    echo "⚠️  CLOAKING DETECTED:\n";
    foreach ($diff as $item) {
        echo "  - $item\n";
    }
}
echo "\n";

// ================== FUNCTIONS ==================

function fetch($url, $ua, $follow, $timeout, $maxRedirects) {
    $ch = curl_init();
    curl_setopt_array($ch, [
        CURLOPT_URL => $url,
        CURLOPT_USERAGENT => $ua,
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_FOLLOWLOCATION => $follow,
        CURLOPT_MAXREDIRS => $maxRedirects,
        CURLOPT_TIMEOUT => $timeout,
        CURLOPT_HEADER => true,
        CURLOPT_SSL_VERIFYPEER => false,
        CURLOPT_SSL_VERIFYHOST => false,
    ]);
    
    $response = curl_exec($ch);
    $info = curl_getinfo($ch);
    $error = curl_error($ch);
    curl_close($ch);

    if ($error) {
        return ['error' => $error, 'code' => 0, 'headers' => [], 'body' => '', 'size' => 0, 'final_url' => $url];
    }

    // Split headers and body
    $headerSize = $info['header_size'];
    $rawHeaders = substr($response, 0, $headerSize);
    $body = substr($response, $headerSize);

    // Parse headers
    $headers = [];
    foreach (explode("\r\n", $rawHeaders) as $line) {
        if (strpos($line, ': ') !== false) {
            list($key, $val) = explode(': ', $line, 2);
            $headers[strtolower($key)] = $val;
        }
    }

    return [
        'code' => $info['http_code'],
        'headers' => $headers,
        'body' => $body,
        'size' => strlen($body),
        'final_url' => $info['url'],
        'error' => null
    ];
}

function compare($normal, $google) {
    $diff = [];

    if ($normal['code'] != $google['code']) {
        $diff[] = "HTTP status differs: normal={$normal['code']}, google={$google['code']}";
    }
    if ($normal['final_url'] != $google['final_url']) {
        $diff[] = "Final URL differs: normal={$normal['final_url']}, google={$google['final_url']}";
    }
    if (abs($normal['size'] - $google['size']) > 1024) {
        $diff[] = "Body size differs significantly: normal=" . number_format($normal['size']) . " bytes, google=" . number_format($google['size']) . " bytes";
    }

    // Check for common cloaking headers
    $suspiciousHeaders = ['x-robots-tag', 'location', 'refresh'];
    foreach ($suspiciousHeaders as $h) {
        $n = $normal['headers'][$h] ?? null;
        $g = $google['headers'][$h] ?? null;
        if ($n !== $g) {
            $diff[] = "Header '$h' differs: normal='$n', google='$g'";
        }
    }

    // Simple content difference (basic)
    if ($normal['body'] !== $google['body']) {
        $diff[] = "Response body content differs (first 200 chars differ or completely different)";
        // You can add a more sophisticated diff here
    }

    return $diff;
}
